# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=credit_risk
POSTGRES_USER=credit_risk_app
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_APPLICATION_NAME=banking_credit_risk

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
RISK_REPORT_API_KEY=replace-with-a-long-random-secret

# Airflow local development
AIRFLOW_PROJECT_POSTGRES_HOST=host.docker.internal
CREDIT_RISK_BATCH_LIMIT=

# Model and experiment tracking
MODEL_PATH=models/model.pkl
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=banking-credit-risk

# Initial risk bands; calibrate with validation data before use
MEDIUM_RISK_THRESHOLD=0.30
HIGH_RISK_THRESHOLD=0.60
